# Copy this to .env and fill in your values
# cp backend/.env.example backend/.env

PORT=3010

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=ai_monitoring

# Telegram Bot (para notificaciones)
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=6801858273

# Alerta: envía Telegram si el gasto diario supera este valor (0 = desactivado)
DAILY_COST_LIMIT_USD=10

# Optional: override en hook scripts
# CLAUDE_MONITOR_URL=http://127.0.0.1:3010

# ─── Dashboard Auth ──────────────────────────────────────────────────────────
# Generar hash con: node -e "const b=require('bcryptjs');b.hash('TU_CONTRASEÑA',10).then(console.log)"
DASHBOARD_PASSWORD_HASH=
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# ─── API Keys panel ──────────────────────────────────────────────────────────
# Ruta al vault de secretos (creado por deploy/scripts/fase-1-seguridad.sh)
KPTL_SECRETS_PATH=/opt/kptl-secrets/api-keys.env

# ─── Cost Alerts ─────────────────────────────────────────────────────────────
# Alerta Telegram si el gasto diario (cualquier proveedor) supera este valor
COST_ALERT_DAILY_USD=5
# Alerta si el gasto mensual supera este valor
COST_ALERT_MONTHLY_USD=50
