# ── Bot Telegram Financiero ───────────────────────────────────────────────────
# Token del nuevo bot (diferente al relay/chat-agent.js)
FIN_TELEGRAM_BOT_TOKEN=

# IDs de chats permitidos (separados por coma; dejar vacío para todos)
FIN_ALLOWED_CHAT_IDS=

# IDs de usuarios admin (separados por coma)
FIN_ADMIN_USER_IDS=

# ── Base de datos (reutiliza la misma que backend) ────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=ai_monitoring

# ── APIs LLM ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# Claude Haiku para visión (OCR de imágenes: fallback cuando GEMINI_API_KEY no está disponible)
ANTHROPIC_API_KEY=
# Gemini 2.5 Flash: DocumentIntelligenceAgent (OCR multimodal, facturas, comprobantes, tablas)
# También habilita TransactionOrchestrator (usa ANTHROPIC_API_KEY)
GEMINI_API_KEY=

# ── Config del negocio ────────────────────────────────────────────────────────
# Los datos bancarios se configuran por tipo de operación desde el dashboard
# (tabla fin_operation_types → campo instrucciones_pago)

# Directorio para guardar archivos subidos
FIN_UPLOADS_DIR=/tmp/fin-uploads

# URL del backend para emitir eventos Socket.io (si se usa en modo standalone)
MONITOR_API_URL=http://127.0.0.1:3010
