{
  "env": {
    "CLAUDE_MONITOR_URL": "https://ia.vilarkptl.com"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-/home/user/agentic-repo}/hooks/hook-pre.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-/home/user/agentic-repo}/hooks/hook-post.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-/home/user/agentic-repo}/hooks/hook-stop.sh"
          }
        ]
      }
    ]
  }
}
