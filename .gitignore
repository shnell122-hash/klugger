# Archivos sensibles — nunca commitear
backend/.env
relay/.env
*.env

# Logs
*.log
logs/
/var/log/ai-monitor/

# Node
node_modules/
backend/node_modules/

# Relay runtime state — must NOT be in git (gitPull would overwrite and re-trigger)
relay/pending-dispatches.json
relay/buzon-fiscalai.md
relay/journals/

# OS
.DS_Store
Thumbs.db

# Simuladores: assets de prueba (binarios con datos reales — generar localmente en servidor)
financial/bot/sims/assets/*.png
financial/bot/sims/assets/*.jpg
financial/bot/sims/assets/*.jpeg
financial/bot/sims/assets/*.pdf
financial/bot/sims/assets/*.xlsx
financial/bot/sims/assets/*.xls
