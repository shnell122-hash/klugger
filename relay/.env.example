# relay/.env — variables de entorno para relay-master y chat-agent
# Copia a relay/.env y llena los valores reales
# NUNCA commitear relay/.env (está en .gitignore)

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token para git push/pull en repos de proyectos
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Anthropic ─────────────────────────────────────────────────────────────────
# API Key principal — usada por Claude CLI (relay-master) y chat-agent
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Admin Key (opcional) — para sincronizar uso/costos desde Anthropic Platform
ANTHROPIC_ADMIN_KEY=

# ── DeepSeek ──────────────────────────────────────────────────────────────────
# Opcional — usado por /tarea planning (master.js) y como modelo alternativo en chat-agent
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Telegram — relay-master ───────────────────────────────────────────────────
# Bot token e ID del chat/grupo para notificaciones del relay
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=6801858273

# ── Telegram — claude-chat-bot ────────────────────────────────────────────────
# Bot token del chat interactivo (distinto al bot de notificaciones)
TG_CLAUDE_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID del grupo con Forum Topics (para enviar mensajes al topic correcto)
TG_CLAUDE_GROUP_ID=
# User IDs de Telegram autorizados a usar el chat (comma-separated)
TG_ALLOWED_USER_IDS=6801858273
# Webhook (opcional) — si está vacío, usa long-polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PORT=3011

# ── relay-master — rutas y timeouts ──────────────────────────────────────────
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_USER=claude-agent
POLL_MS=15000
CLAUDE_TIMEOUT_MS=1500000
MONITOR_API_URL=http://127.0.0.1:3010
PLATFORM_POLL_MS=900000
BUZON_DEST_PATH=/var/www/html/vilarkptl.com/DeCabeceraTax/relay/buzon-ia.md
BUZON_DEST_REPO=/var/www/html/vilarkptl.com/DeCabeceraTax
BUZON_DEST_BRANCH=claude/ml-backend-69bis-module-5iap0

# ── MySQL (usado por chat-agent y backend) ────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=ai_monitoring

# ── chat-agent — circuit breakers ────────────────────────────────────────────
MAX_COST_USD=1.00
TOKEN_BUDGET=180000
TASK_TIMEOUT_MS=300000

# ── LiteLLM proxy (Phase 1a — localhost) ─────────────────────────────────────
# Si LITELLM_BASE_URL está definido, chat-agent enruta TODAS las llamadas LLM
# a través del proxy (que maneja el fallback chain internamente).
# Si está vacío, se usan los SDKs directos de Anthropic y DeepSeek (comportamiento original).
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
