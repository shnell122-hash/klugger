# relay/.env — variables para el watcher
# Copia a relay/.env y llena los valores
# NUNCA commitear este archivo (está en .gitignore)

# GitHub Personal Access Token (para git push/pull sin passphrase)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (para ejecutar Claude en el servidor)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=6801858273
